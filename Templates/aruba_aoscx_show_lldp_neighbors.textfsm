Value Required LOCAL_INTERFACE (\S+)
Value Required CHASSIS_ID (\S+)
Value NEIGHBOR_PORT_ID (\S+)
Value NEIGHBOR_INTERFACE (.+?)
Value NEIGHBOR_NAME (\S+)

Start
  ^LOCAL-PORT\s+CHASSIS-ID\s+PORT-ID\s+PORT-DESC\s+TTL\s+SYS-NAME -> Rows
  ^\s*$$
  ^. -> Start

Rows
  ^${LOCAL_INTERFACE}\s+${CHASSIS_ID}\s+${NEIGHBOR_PORT_ID}\s+${NEIGHBOR_INTERFACE}\s+\d+\s+${NEIGHBOR_NAME}\s*$$ -> Record
  ^-+$$
  ^\s*$$ -> Start
  ^. -> Rows